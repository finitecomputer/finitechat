# Copy to .env for local smoke runs. The smoke wrapper sources this file if it
# exists, but real .env files stay gitignored.

# Use local for fast Docker proof, or s3 for the Latitude/Tinfoil path.
FINITE_DOCKER_RESTIC_BACKEND=s3

# Option A: provide the full restic repository URL.
# Format: s3:https://<endpoint>/<bucket>/<prefix>
# Example for Latitude Object Storage:
FINITE_DOCKER_RESTIC_REPOSITORY=s3:https://objects.nyc.storage.sh/tinfoil-agent-spike/hermes-docker-smoke

# Option B: leave FINITE_DOCKER_RESTIC_REPOSITORY empty and let the smoke derive
# it from the Latitude bucket and prefix below.
# FINITE_LATITUDE_OBJECT_ENDPOINT=https://objects.nyc.storage.sh
# FINITE_LATITUDE_STORAGE_BUCKET=tinfoil-agent-spike
# FINITE_DOCKER_RESTIC_PREFIX=hermes-docker-smoke

# User-owned restore key. The operator should not be able to decrypt user state
# without this value.
FINITE_DOCKER_RESTIC_PASSWORD=

# Latitude Object Storage credentials. These are promoted to AWS_* env vars by
# scripts/hermes-sidecar-docker-smoke.sh before restic runs.
FINITE_DOCKER_RESTIC_AWS_ACCESS_KEY_ID=
FINITE_DOCKER_RESTIC_AWS_SECRET_ACCESS_KEY=

# Optional, depending on provider behavior.
# FINITE_DOCKER_RESTIC_AWS_REGION=us-east-1
# FINITE_DOCKER_RESTIC_AWS_SESSION_TOKEN=

# Tinfoil control-plane auth for the later canary phase. The Docker smoke does
# not use this, but the manual Tinfoil canary/runbook will.
TINFOIL_API_KEY=
